{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aem",
  "version": "0.2.0",
  "identifier": "com.neycasilla.aem",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/aem/browser"
  },
  "app": {
    "windows": [
      {
        "title": "aem",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGQ0YwRDQ1NzMwOURDREMKUldUYzNBbHpSUTNQUDNwMDJabVVxdEpSL0xhRStZUE5CNjRiQnF2bGZFN1FtMzhGNUJGREJ2ZHYK",
      "endpoints": [
        "https://github.com/ZyenxD/aem/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
